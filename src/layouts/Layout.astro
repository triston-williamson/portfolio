---
interface Props { title?: string; description?: string }
const {
  title = 'Triston Williamson | AI Automation Engineer',
  description = 'Portfolio of Triston Williamson: AI automation, data engineering and data science in finance.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <a href="/" class="brand">TW</a>
      <div>
        <a href="/#projects">Projects</a>
        <a href="/#skills">Skills</a>
        <a href="/#experience">Experience</a>
        <a href="/#contact">Contact</a>
      </div>
    </nav>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} Triston Williamson</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --surface: #f4f6fa; --text: #14213d; --muted: #5b6475;
    --accent: #1f4e8c; --border: #e1e5ee;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0d1117; --surface: #161b22; --text: #e6edf3; --muted: #9aa4b2; --accent: #6ea8fe; --border: #30363d; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; line-height: 1.6; }
  main { max-width: 960px; margin: 0 auto; padding: 0 20px 64px; }
  nav { max-width: 960px; margin: 0 auto; padding: 20px; display: flex; justify-content: space-between; align-items: center; }
  nav a { color: var(--muted); text-decoration: none; margin-left: 20px; }
  nav a:hover { color: var(--accent); }
  nav .brand { color: var(--text); font-weight: 800; margin-left: 0; }
  a { color: var(--accent); }
  h2 { margin-top: 72px; font-size: 1.6rem; }
  .tag { display: inline-block; font-size: .8rem; padding: 2px 10px; border-radius: 999px; background: var(--surface); border: 1px solid var(--border); margin: 0 6px 6px 0; }
  footer { text-align: center; color: var(--muted); padding: 32px; border-top: 1px solid var(--border); }
  @media (max-width: 600px) { nav div a { margin-left: 12px; font-size: .9rem; } }
</style>